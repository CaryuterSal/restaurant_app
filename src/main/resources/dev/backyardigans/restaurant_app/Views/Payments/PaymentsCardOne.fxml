<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="300.0" prefWidth="432.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-radius: 10;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.backyardigans.restaurant_app.HelloController">
    <children>

        <HBox layoutX="-2.0" layoutY="6.0" prefHeight="59.0" prefWidth="439.0">
            <children>
            <ImageView fitHeight="42.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Images/Back.png" />
               </image>
               <HBox.margin>
                  <Insets left="20.0" top="20.0" />
               </HBox.margin>
            </ImageView>
                <Label text="Pago con tarjeta" textFill="#26150f">
                    <font>
                        <Font name="Roboto Light" size="22.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="100.0" top="20.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
        <Button fx:id="btnCancelar" layoutX="142.0" layoutY="277.0" mnemonicParsing="false" prefHeight="180.0" prefWidth="150.0" style="-fx-background-color: #26150F; -fx-background-radius: 10;" text="Débito" textFill="WHITE" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="90.0">
            <font>
                <Font size="25.0" />
            </font>
        </Button>

        <Button fx:id="btnGuardar" layoutX="320.0" layoutY="277.0" mnemonicParsing="false" prefHeight="180.0" prefWidth="150.0" style="-fx-background-color: #26150F; -fx-background-radius: 10;" text="Crédito" textFill="WHITE" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="90.0">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
    </children>
</AnchorPane>

