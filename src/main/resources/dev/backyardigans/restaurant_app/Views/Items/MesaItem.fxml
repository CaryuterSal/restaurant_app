<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #d9b89c; -fx-padding: 15; -fx-background-radius: 15;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="dev.backyardigans.restaurant_app.HelloController">

    <Label fx:id="lblNombreMesa" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Mesa #" />

    <Region prefHeight="37.0" prefWidth="433.0" HBox.hgrow="ALWAYS" />

    <Button fx:id="btnEditar" prefHeight="37.0" prefWidth="91.0" style="-fx-background-color: #CFCAC5; -fx-background-radius: 10; -fx-text-fill: #473A35;" text="Editar" visible="false">
      <font>
         <Font size="15.0" />
      </font></Button>

    <Button fx:id="btnPagar" prefHeight="36.0" prefWidth="91.0" style="-fx-background-color: #401E12; -fx-text-fill: white; -fx-background-radius: 10;" text="Pagar" visible="false">
      <font>
         <Font size="15.0" />
      </font></Button>
    
    <Button fx:id="btnAsignar" prefHeight="36.0" prefWidth="91.0" style="-fx-background-color: #401E12; -fx-text-fill: white; -fx-background-radius: 10;" text="Asignar" visible="false">
      <font>
         <Font size="15.0" />
      </font></Button>

</HBox>
