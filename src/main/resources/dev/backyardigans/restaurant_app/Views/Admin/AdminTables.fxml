<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.backyardigans.restaurant_app.HelloController">

    <top>
        <VBox>
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #5C4137;">
                    <children>
                        <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="25.0" style="-fx-background-color: #5C4137;">
                            <graphic>
                                <ImageView fitHeight="33.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../Images/LogOut.png" />
                                    </image></ImageView>
                            </graphic>
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Button>
                        <Label text="SISTEMA RESTAURANTE" textFill="WHITE">
                            <font>
                                <Font name="Roboto Light" size="11.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" prefHeight="25.0" prefWidth="25.0" style="-fx-background-color: #5C4137;">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">

                                </ImageView>
                            </graphic>
                            <HBox.margin>
                                <Insets right="20.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0" style="-fx-background-color: fff;">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <children>
                <Region layoutX="20.0" layoutY="110.0" maxHeight="10.0" prefHeight="348.0" prefWidth="230.0" />
                <Button fx:id="resguardo" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="50.0" style="-fx-background-radius: 10; -fx-background-color: BCB8B8;" text="Menú">
                    <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../Images/Fork.png" />
                            </image></ImageView>
                    </graphic>
                    <font>
                        <Font name="Roboto Light" size="12.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </Button>
                <Region maxHeight="10.0" prefHeight="348.0" prefWidth="230.0" VBox.vgrow="ALWAYS" />
                <Button fx:id="empleados" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" prefHeight="50.0" style="-fx-background-radius: 10; -fx-background-color: BCB8B8;" text="Meseros">
                    <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../Images/Dish.png" />
                            </image></ImageView>
                    </graphic>
                    <font>
                        <Font name="Roboto Light" size="12.0" />
                    </font>
                </Button>

            </children>
        </VBox>
    </left>

    <center>
        <HBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">

            <!-- GRID DE PLATILLOS -->
            <GridPane fx:id="gridPlatillos" hgap="20" vgap="20">
                <columnConstraints>
                    <ColumnConstraints halignment="CENTER" />
                    <ColumnConstraints halignment="CENTER" />
                    <ColumnConstraints halignment="CENTER" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints valignment="CENTER" />
                    <RowConstraints valignment="CENTER" />
                    <RowConstraints valignment="CENTER" />
                    <RowConstraints valignment="CENTER" />
                    <RowConstraints valignment="CENTER" />
                </rowConstraints>

                <!-- Aquí añadirás los VBoxes de cada platillo -->
                <FlowPane fx:id="contenedorPlatillos" hgap="30" vgap="30" />
            <HBox prefHeight="100.0" prefWidth="768.0">
               <children>
                      <Button mnemonicParsing="false" prefHeight="100.0" prefWidth="250.0" style="-fx-background-color: #5A3E2B; -fx-text-fill: white; -fx-border-radius: 20;" text="+ Agregar mesero">
                          <font>
                              <Font size="24.0" />
                          </font>
                     <HBox.margin>
                        <Insets left="20.0" top="20.0" />
                     </HBox.margin>
                      </Button>
                  <TextField prefHeight="42.0" prefWidth="287.0" promptText="Buscar mesero">
                     <HBox.margin>
                        <Insets left="160.0" top="40.0" />
                     </HBox.margin>
                  </TextField>
                  <Button mnemonicParsing="false" prefHeight="42.0" prefWidth="42.0" style="-fx-background-color: #5A3E2B; -fx-text-fill: white; -fx-border-radius: 10;" text="🔎">
                     <HBox.margin>
                        <Insets left="20.0" top="40.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
                <TableView prefHeight="345.0" prefWidth="729.0" GridPane.rowIndex="4">
                    <columns>
                        <TableColumn prefWidth="295.0" style="-fx-background-color: #5C4137; -fx-text-fill: white;" text="Mesa" />
                  <TableColumn prefWidth="433.0" style="-fx-background-color: #5C4137; -fx-text-fill: white;" text="Mesero" />
                    </columns>
                    <GridPane.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" />
                    </GridPane.margin>
                </TableView>
                <opaqueInsets>
                    <Insets bottom="30.0" left="30.0" top="30.0" />
                </opaqueInsets>

            </GridPane>

        </HBox>
    </center>
</BorderPane>
